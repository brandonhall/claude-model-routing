#!/usr/bin/env python3
"""Attach ROUTING.md to the start of every session.

The note lives in ROUTING.md at the repo root so the same text can be dropped into
AGENTS.md for tools that have no hook layer (Codex, Cursor, and the like). Python
rather than bash: bash 5.3+ can hang on heredocs in hooks, and this hook is
synchronous, so a hang would block the session instead of skipping the note.
Any failure here is silent: the session starts without the note.
"""

import json
import os
import sys


def main():
    here = os.path.dirname(os.path.abspath(__file__))
    candidates = [
        os.path.join(here, "..", "ROUTING.md"),            # copied into the plugin
        os.path.join(here, "..", "..", "..", "ROUTING.md"),  # repo root
    ]
    for path in candidates:
        try:
            with open(path, encoding="utf-8") as fh:
                note = fh.read().strip()
            break
        except OSError:
            continue
    else:
        return
    json.dump(
        {
            "hookSpecificOutput": {
                "hookEventName": "SessionStart",
                "additionalContext": note,
            }
        },
        sys.stdout,
    )


if __name__ == "__main__":
    main()
