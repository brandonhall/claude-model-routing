#!/usr/bin/env python3
"""Attach the routing note to the start of every session.

Order of preference:
  1. <project>/.claude/routing.md  - a per-project override, if the repo has one
  2. ROUTING.md shipped inside the plugin

The note is plain markdown so the same file can be pasted into AGENTS.md for tools
that have no hook layer (Codex, Cursor, and the like).

Python rather than bash: bash 5.3+ can hang on heredocs in hooks, and this hook is
synchronous, so a hang would block the session instead of skipping the note. Any
failure here is silent: the session starts without the note.
"""

import json
import os
import sys


def read(path):
    try:
        with open(path, encoding="utf-8") as fh:
            return fh.read().strip()
    except OSError:
        return None


def main():
    try:
        payload = json.load(sys.stdin)
    except Exception:
        payload = {}
    cwd = payload.get("cwd") if isinstance(payload, dict) else None
    cwd = cwd or os.getcwd()
    here = os.path.dirname(os.path.abspath(__file__))

    note = read(os.path.join(cwd, ".claude", "routing.md")) or read(
        os.path.join(here, "..", "ROUTING.md")
    )
    if not note:
        return
    json.dump(
        {
            "hookSpecificOutput": {
                "hookEventName": "SessionStart",
                "additionalContext": note,
            }
        },
        sys.stdout,
    )


if __name__ == "__main__":
    main()
